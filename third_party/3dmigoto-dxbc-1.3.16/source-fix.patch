+struct declaration_range_operand {
+	DWORD register_index;
+	DWORD first;
+	DWORD last;
+	DWORD count;
+};
+
+static bool parse_declaration_range_operand(const string &text, const char *prefix,
+		bool cbuffer, declaration_range_operand *range)
+{
+	const size_t prefix_len = strlen(prefix);
+	if (text.compare(0, prefix_len, prefix) != 0)
+		return false;
+	size_t open = text.find('[', prefix_len);
+	if (open == string::npos)
+		return false;
+	size_t close = text.find(']', open + 1);
+	auto malformed = [&text]() {
+		throw AssemblerParseError(text, "Malformed ranged declaration operand");
+	};
+	if (close == string::npos) {
+		if (text.find(':', open + 1) != string::npos)
+			malformed();
+		return false;
+	}
+	string bounds = text.substr(open + 1, close - open - 1);
+	size_t colon = bounds.find(':');
+	if (colon == string::npos) {
+		if (text.find(':', close + 1) != string::npos)
+			malformed();
+		return false; // Ordinary single-index operands still use assembleOp.
+	}
+	if (bounds.find(':', colon + 1) != string::npos)
+		malformed();
+	DWORD register_index, first, last;
+	if (!parse_immediate_index(text.substr(prefix_len, open - prefix_len), &register_index) ||
+		!parse_immediate_index(bounds.substr(0, colon), &first) ||
+		!parse_immediate_index(bounds.substr(colon + 1), &last) || first > last)
+		malformed();
+	range->register_index = register_index;
+	range->first = first;
+	range->last = last;
+	range->count = 0;
+	size_t cursor = close + 1;
+	if (cbuffer) {
+		// The constant-buffer vector count must immediately follow the register range.
+		if (cursor >= text.size() || text[cursor] != '[')
+			malformed();
+		size_t count_close = text.find(']', cursor + 1);
+		if (count_close == string::npos || count_close + 1 != text.size() ||
+			!parse_immediate_index(text.substr(cursor + 1, count_close - cursor - 1), &range->count))
+			malformed();
+	} else if (cursor != text.size()) {
+		malformed();
+	}
+	return true;
+}
+
+static vector<DWORD> assemble_declaration_range_operand(const declaration_range_operand &range,
+		unsigned file)
+{
+	DWORD op = 0;
+	token_operand *operand = (token_operand *)&op;
+	operand->comps_enum = 2;
+	operand->mode = 1;
+	operand->sel = 0xe4;
+	operand->file = file;
+	operand->num_indices = 3;
+	vector<DWORD> encoded;
+	encoded.push_back(op);
+	encoded.push_back(range.register_index);
+	encoded.push_back(range.first);
+	encoded.push_back(range.last);
+	return encoded;
+}
+
+static bool parse_declaration_space(const vector<string> &words, size_t index, DWORD *space)
+{
+	if (index >= words.size())
+		return false;
+	const string prefix = "space=";
+	if (words[index].compare(0, prefix.size(), prefix) != 0 ||
+		!parse_immediate_index(words[index].substr(prefix.size()), space))
+		throw AssemblerParseError(words[index], "Invalid register space in declaration");
+	return true;
+}
