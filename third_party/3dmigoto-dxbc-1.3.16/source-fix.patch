+static bool parse_immediate_index(const string &s, DWORD *value)
+{
+	if (s.empty() || s[0] < '0' || s[0] > '9')
+		return false;
+	char *end = NULL;
+	errno = 0;
+	unsigned long parsed = strtoul(s.c_str(), &end, 10);
+	if (errno == ERANGE || end == s.c_str() || *end || parsed > 0xffffffffUL)
+		return false;
+	*value = (DWORD)parsed;
+	return true;
+}
+
+static bool parse_index_offset(const string &s, long *value)
+{
+	if (s.empty())
+		return false;
+	char *end = NULL;
+	errno = 0;
+	long parsed = strtol(s.c_str(), &end, 10);
+	if (errno == ERANGE || end == s.c_str() || *end)
+		return false;
+	*value = parsed;
+	return true;
+}
+
+static void append_index_dimension(const string &expression, unsigned *representation,
+		vector<DWORD> *encoded)
+{
+	DWORD immediate;
+	if (parse_immediate_index(expression, &immediate)) {
+		*representation = 0; // Immediate32
+		encoded->push_back(immediate);
+		return;
+	}
+
+	string register_expression = expression;
+	long offset = 0;
+	bool has_explicit_offset = false;
+	size_t plus = expression.find(" + ");
+	if (plus != string::npos) {
+		register_expression = expression.substr(0, plus);
+		if (!parse_index_offset(expression.substr(plus + 3), &offset) ||
+			offset < (-2147483647L - 1L) || offset > 2147483647L)
+			throw AssemblerParseError(expression, "Unsupported relative constant-buffer index expression");
+		has_explicit_offset = true;
+	}
+	if (register_expression.empty())
+		throw AssemblerParseError(expression, "Relative constant-buffer index has no register expression");
+	vector<DWORD> relative = assembleOp(register_expression);
+	if (relative.empty())
+		throw AssemblerParseError(expression, "Relative constant-buffer index did not encode");
+	if (has_explicit_offset) {
+		*representation = 3; // Immediate32 + Relative, including an explicit zero offset
+		encoded->push_back((DWORD)offset);
+	} else {
+		*representation = 2; // Relative
+	}
+	encoded->insert(encoded->end(), relative.begin(), relative.end());
+}
